---
const footerLinks = [
  { href: "/faq", label: "FAQ" },
  { href: "/shipping-returns", label: "Shipping & Returns" },
  { href: "/size-guide", label: "Size Guide" },
];
---

<footer class="border-t border-theme-muted/30 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="flex flex-wrap justify-center gap-6 mb-6">
      {footerLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm tracking-wide text-theme-muted hover:text-theme-text transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <p class="text-center text-xs text-theme-muted">
      &copy; 2026 Woodland Kin. Big Bear Valley, CA.
    </p>
  </div>
</footer>
