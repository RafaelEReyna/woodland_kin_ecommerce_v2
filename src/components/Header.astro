---
import CartIcon from "./CartIcon";

const navLinks = [
  { href: "/shop", label: "Shop" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 bg-theme-surface/95 backdrop-blur-sm border-b border-theme-border">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="text-lg font-semibold tracking-widest text-theme-text">
      WOODLAND KIN
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm tracking-wide text-theme-text-muted hover:text-theme-text transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-4">
      <CartIcon client:idle />

      <!-- Mobile Menu Toggle -->
      <label for="mobile-menu-toggle" class="md:hidden cursor-pointer text-theme-text" aria-label="Toggle menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </label>
    </div>
  </nav>

  <!-- Mobile Menu (CSS-only toggle) -->
  <input type="checkbox" id="mobile-menu-toggle" class="hidden peer" aria-hidden="true" />
  <div class="hidden peer-checked:block md:hidden border-t border-theme-text-muted/20 bg-theme-bg">
    <ul class="px-4 py-4 space-y-3">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="block text-sm tracking-wide text-theme-text-muted hover:text-theme-text transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
