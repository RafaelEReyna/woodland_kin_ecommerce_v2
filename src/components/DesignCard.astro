---
interface Props {
  name: string;
  slug: string;
  featuredImage: string;
}

const { name, slug, featuredImage } = Astro.props;
---

<a href={`/shop/${slug}`} class="group block">
  <div class="aspect-[4/5] bg-theme-surface rounded-lg flex items-center justify-center overflow-hidden group-hover:scale-[1.02] group-hover:shadow-lg transition-all duration-200">
    <span class="text-theme-muted text-sm"><!-- TODO: Replace placeholder images with real assets -->[{name}]</span>
  </div>
  <h3 class="mt-3 text-sm font-medium">{name}</h3>
  <p class="text-sm text-theme-muted">From $25</p>
</a>
