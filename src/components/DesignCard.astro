---
interface Props {
  name: string;
  slug: string;
  featuredImage: string;
}

const { name, slug, featuredImage } = Astro.props;
---

<a href={`/shop/${slug}`} class="group block">
  <div class="aspect-[4/5] bg-theme-surface rounded-lg overflow-hidden group-hover:scale-[1.02] group-hover:shadow-lg transition-all duration-200">
    <img src={featuredImage} alt={name} class="w-full h-full object-cover" loading="lazy" />
  </div>
  <h3 class="mt-3 text-sm font-medium">{name}</h3>
  <p class="text-sm text-theme-text-muted">From $25</p>
</a>
