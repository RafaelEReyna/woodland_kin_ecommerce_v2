---
import BaseLayout from "../layouts/BaseLayout.astro";
import DesignCard from "../components/DesignCard.astro";
import { getCollection } from "astro:content";

const designs = (await getCollection("designs"))
  .filter((d) => d.data.active)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Shop the Collection — Woodland Kin" description="Browse all 20 Woodland Kin designs. Mountain rooted apparel from Big Bear Valley, CA.">
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold">The Collection</h1>
      <p class="mt-4 text-theme-muted">20 designs. Rooted in the mountain.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {designs.map((design) => (
        <DesignCard
          name={design.data.name}
          slug={design.id.replace(/\.md$/, "")}
          featuredImage={design.data.featured_image}
        />
      ))}
    </div>
  </section>
</BaseLayout>
