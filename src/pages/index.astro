---
import BaseLayout from "../layouts/BaseLayout.astro";
import DesignCard from "../components/DesignCard.astro";
import EmailCapture from "../components/EmailCapture";
import { getCollection } from "astro:content";

const designs = (await getCollection("designs"))
  .filter((d) => d.data.active)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout title="Woodland Kin — Mountain Rooted Apparel">
  <!-- Hero -->
  <section class="hero grain-overlay">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 text-center relative z-10">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
        Mountain Rooted. Community Worn.
      </h1>
      <p class="mt-6 text-lg md:text-xl text-theme-text-muted max-w-2xl mx-auto">
        Apparel for families who find themselves in the forest. Designed in Big Bear Valley, CA — worn by the people who call the mountain home.
      </p>
      <a
        href="/shop"
        class="inline-block mt-10 px-8 py-3 bg-theme-accent text-theme-bg text-sm font-medium tracking-wide rounded hover:opacity-90 transition-opacity"
      >
        Shop the Collection
      </a>
    </div>
  </section>

  <!-- Brand Story -->
  <section class="bg-theme-bg-subtle">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold mb-6">Our Story</h2>
        <p class="text-theme-text-muted leading-relaxed mb-4">
          Woodland Kin started the way most good things do — three friends, good music, strong drinks, and the occasional cigar. Eddie and Natalie from Fawnskin, Jon from Moonridge. Somewhere between the whiskey and the laughter, an idea took shape: apparel that actually represents this place. Not generic prints slapped on blanks with no connection to what we love or who we are. Something with roots. Something that belongs here.
        </p>
        <p class="text-theme-text-muted leading-relaxed">
          Every design represents a different corner of this valley. Each area has its own pride, its own story. But we all share the same mountains and the same stubborn love for this place. This isn't hype. It's home.
        </p>
      </div>
      <div class="aspect-[4/3] rounded-lg overflow-hidden">
        <img src="/images/hero/three-friends-snow-dog-big-bear-lake.JPG" alt="Eddie, Natalie, and Jon in the snow at Big Bear" class="w-full h-full object-cover" />
      </div>
    </div>
    </div>
  </section>

  <!-- Community Imagery -->
  <section class="bg-theme-bg">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <h2 class="text-2xl md:text-3xl font-bold text-center mb-12">The Community</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { caption: "Trail mornings in Big Bear" },
          { caption: "Campfire gatherings" },
          { caption: "Mountain family roots" },
        ].map((item) => (
          <div>
            <div class="aspect-[4/5] bg-theme-surface rounded-lg flex items-center justify-center">
              <span class="text-theme-text-muted text-sm"><!-- TODO: Replace placeholder images with real assets -->[Photo]</span>
            </div>
            <p class="mt-3 text-sm text-theme-text-muted text-center">{item.caption}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Designs -->
  <section class="bg-theme-bg-subtle">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <h2 class="text-2xl md:text-3xl font-bold text-center mb-4">Featured Designs</h2>
    <p class="text-theme-text-muted text-center mb-12">20 designs. Rooted in the mountain.</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {designs.map((design) => (
        <DesignCard
          name={design.data.name}
          slug={design.id.replace(/\.md$/, "")}
          featuredImage={design.data.featured_image}
        />
      ))}
    </div>
    <div class="text-center mt-10">
      <a
        href="/shop"
        class="text-sm font-medium text-theme-accent hover:underline"
      >
        View All &rarr;
      </a>
    </div>
    </div>
  </section>

  <!-- Email Capture -->
  <section class="bg-theme-bg">
    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Join the Kin</h2>
      <p class="text-theme-text-muted mb-8">
        First access to new drops, mountain stories, and community events. No spam — just the good stuff.
      </p>
      <EmailCapture client:visible />
    </div>
  </section>
</BaseLayout>
