---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Order Cancelled — Woodland Kin" description="Your order was cancelled. Your cart is still saved.">
  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">Your order was cancelled.</h1>
    <p class="text-theme-text-muted mb-8">
      Your cart is still saved. Ready when you are.
    </p>
    <a
      href="/shop"
      class="inline-block px-8 py-3 bg-theme-accent text-theme-bg text-sm font-medium rounded hover:opacity-90 transition-opacity"
    >
      Back to Shop
    </a>
  </section>
</BaseLayout>
