---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Order Confirmed — Woodland Kin" description="Thank you for your order from Woodland Kin.">
  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">Thank you for your order!</h1>
    <p class="text-theme-text-muted mb-8">
      Your mountain gear is being crafted. You'll receive a confirmation email shortly.
    </p>
    <a
      href="/shop"
      class="inline-block px-8 py-3 bg-theme-accent text-theme-bg text-sm font-medium rounded hover:opacity-90 transition-opacity"
    >
      Back to Shop
    </a>
  </section>
</BaseLayout>
